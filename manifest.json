{
  "manifest_version": 3,
  "name": "Auto Refresh",
  "version": "1.2.0",
  "description": "Automatically refresh a webpage at a configurable interval.",
  "permissions": ["alarms", "storage", "activeTab"],
  "optional_permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Refresh",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}